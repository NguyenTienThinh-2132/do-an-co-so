# Native PostgreSQL managed for FinAI, no Docker required.
# First run: node scripts/start-postgres-native.mjs
# The script generates real credentials and updates .env privately.
# For an existing PostgreSQL installation instead, use your real app role/port.
DATABASE_URL=postgresql://finai_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/finai_tv3_demo?schema=public
